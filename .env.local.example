NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Usada pela rota /api/nota-fiscal para chamar a Claude Vision API
ANTHROPIC_API_KEY=sua-chave-anthropic

# Service role key do Supabase (Project Settings → API) — usada apenas pelo
# cron de renovação de dívidas recorrentes (/api/cron/renovar-dividas).
# NUNCA expor com o prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role

# Segredo que protege a rota de cron. Gere um valor aleatório (ex: openssl rand -hex 32)
# e cadastre o mesmo valor nas variáveis de ambiente do Vercel.
CRON_SECRET=um-segredo-aleatorio-forte
