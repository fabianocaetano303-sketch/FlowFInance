(Ganho_Dia          = soma\(ganhos de hoje\)) Tj
T* (Gasto_Dia          = soma\(gastos de hoje\)) Tj
T* (Sobrou_Dia         = Ganho_Dia - Gasto_Dia) Tj
T* () Tj
T* (Media_Diaria       = soma\(ganhos do mes ate hoje\) / dia_atual_do_mes) Tj
T* (Projecao_Mes       = Media_Diaria * dias_totais_no_mes) Tj
T* () Tj
T* (Falta_Pagar\(divida\)= max\(0, valor_total - valor_pago\)) Tj
T* (Total_Dividas      = soma\(valor_total\) das dividas abertas) Tj
T* (Ja_Separado        = soma\(valor_separado\) das dividas abertas) Tj
T* () Tj
T* (Variacao_%         = \(Atual - Anterior\) / Anterior * 100) Tj
T* (Taxa_Economia      = clamp\(\(Ganhos - Gastos\) / Ganhos, 0, 1\)) Tj
T* (Score_Eficiencia   = arredondar\(Taxa_Economia * 10\)   // 0 a 10) Tj
T* () Tj
T* (Saldo_Acumulado\(d\) = Saldo_Acumulado\(d-1\) + Ganho\(d\) - Gasto\(d\)) Tj
T* () Tj
T* (Falta_para_Contas  = max\(0, orcamento_contas - \(Ganhos_Mes - Gastos_Mes\)\)) Tj
